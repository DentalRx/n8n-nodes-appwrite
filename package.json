{
	"name": "@dentalrx/n8n-nodes-appwrite",
	"version": "0.1.0",
	"description": "n8n community node for Appwrite using the modern TablesDB API (tables, rows, and columns)",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"appwrite",
		"tablesdb",
		"backend",
		"baas",
		"database",
		"storage",
		"authentication"
	],
	"license": "MIT",
	"homepage": "https://github.com/dentalrx/n8n-nodes-appwrite",
	"author": {
		"name": "DentalRx",
		"email": "admin@dentalrx.ca"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dentalrx/n8n-nodes-appwrite.git"
	},
	"engines": {
		"node": ">=18.17.0"
	},
	"scripts": {
		"build": "tsc && npm run copy-assets",
		"copy-assets": "cp nodes/Appwrite/appwrite.svg dist/nodes/Appwrite/",
		"dev": "tsc --watch",
		"lint": "eslint nodes credentials --ext .ts",
		"lint:fix": "eslint nodes credentials --ext .ts --fix",
		"format": "prettier --write \"nodes/**/*.ts\" \"credentials/**/*.ts\"",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/AppwriteApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Appwrite/Appwrite.node.js"
		]
	},
	"dependencies": {
		"node-appwrite": "^20.3.0"
	},
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"n8n-workflow": "^1.82.0",
		"prettier": "^3.3.0",
		"typescript": "^5.5.0"
	}
}
