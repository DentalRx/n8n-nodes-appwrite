{
	"name": "@dentalrx/n8n-nodes-appwrite",
	"version": "0.1.0",
	"description": "n8n community node for Appwrite using the modern TablesDB API (tables, rows, and columns)",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"appwrite",
		"tablesdb",
		"backend",
		"baas",
		"database",
		"storage",
		"authentication"
	],
	"license": "MIT",
	"homepage": "https://github.com/DentalRx/n8n-nodes-appwrite",
	"author": {
		"name": "DentalRx",
		"email": "admin@dentalrx.ca"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DentalRx/n8n-nodes-appwrite.git"
	},
	"engines": {
		"node": ">=18.17.0"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AppwriteApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Appwrite/Appwrite.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.45.4",
		"@types/node": "^22.15.0",
		"eslint": "^9.32.0",
		"n8n-workflow": "*",
		"prettier": "^3.6.2",
		"typescript": "^5.9.2"
	}
}
